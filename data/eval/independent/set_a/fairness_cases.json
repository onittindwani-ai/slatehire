{
  "set": "set_a",
  "rule": "see README",
  "cases": [
    {
      "id": "clear_flag",
      "description": "Two groups, one clearly below four fifths.",
      "min_group_size": 5,
      "steps": {
        "screen": {
          "A": {
            "entered": 20,
            "advanced": 10
          },
          "B": {
            "entered": 20,
            "advanced": 6
          }
        }
      },
      "expected": {
        "screen": {
          "rates": {
            "A": "1/2",
            "B": "3/10"
          },
          "assessed_groups": [
            "A",
            "B"
          ],
          "not_assessed_small": [],
          "reference_group": "A",
          "ratios": {
            "A": "1",
            "B": "3/5"
          },
          "flagged": [
            "B"
          ],
          "indicator": "flag"
        }
      },
      "hand_working": "A 10/20=1/2, B 6/20=3/10. Ref A. B ratio (3/10)/(1/2)=3/5=0.6 < 4/5 so flagged."
    },
    {
      "id": "exactly_four_fifths",
      "description": "Ratio exactly 4/5 is not flagged (flag only when strictly below).",
      "min_group_size": 5,
      "steps": {
        "screen": {
          "A": {
            "entered": 20,
            "advanced": 10
          },
          "B": {
            "entered": 20,
            "advanced": 8
          }
        }
      },
      "expected": {
        "screen": {
          "rates": {
            "A": "1/2",
            "B": "2/5"
          },
          "assessed_groups": [
            "A",
            "B"
          ],
          "not_assessed_small": [],
          "reference_group": "A",
          "ratios": {
            "A": "1",
            "B": "4/5"
          },
          "flagged": [],
          "indicator": "ok"
        }
      },
      "hand_working": "A 1/2, B 8/20=2/5. Ratio (2/5)/(1/2)=4/5, equal to 0.8, not below, so ok."
    },
