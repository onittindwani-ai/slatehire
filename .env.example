# Slatehire environment. Names only. Copy to .env and fill in what you use. Never commit .env. Every name is explained in docs/04-ENVIRONMENT-VARIABLES.md.
# A group whose heading says "all or none" is switched off when you leave it empty and must be filled in completely once you start.
# An empty value counts as not set, so a line you do not use can stay as it is.

# Core
APP_NAME=slatehire
DATABASE_URL=sqlite:///./slatehire.sqlite3
# Make one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"  (32 or more random characters; the app refuses to start on this example value when DEMO_MODE is false)
SESSION_SECRET=change-me-to-a-long-random-string
# draft: nothing leaves the app, offers stay files for a person. live: only after docs/09-GO-LIVE-CHECKLIST.md
MODE=draft
# false for any real install. true is the offline demo with sample people (it also switches on public demo passwords, which a real install never has)
DEMO_MODE=false
# Only for a throw away demo on a server database. Leave false.
ALLOW_DEMO_SERVER=false
KILL_SWITCH=false
# The largest request the API accepts, in bytes (25 MB)
MAX_BODY_BYTES=26214400
# Docker compose only: the database password. Letters and digits only. Make one: openssl rand -hex 24
POSTGRES_PASSWORD=
# The folder with the demo data and the starting rubrics. Set automatically when you run from the repository; the Docker image sets it to /app/data.
SEED_DIR=

# The key of the one way hashes that stop a deleted person being added again. 32 or more random characters, kept in the environment only and kept as long as the data.
# Make one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"  (the app refuses to start outside the demo while it is empty)
SUPPRESSION_KEY=

# Sign in (make the hash with: python tools/hash_password.py). Keep the single quotes.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=
# The second person. The person who writes an offer's terms cannot approve them, so a real install needs one of these two.
APPROVER_EMAIL=
APPROVER_PASSWORD_HASH=
# Optional extra sign ins: [{"email": "...", "password_hash": "...", "role": "approver" or "viewer"}]
MEMBERS_JSON=
# Optional read only sign in (looks at everything, changes nothing)
VIEWER_EMAIL=
VIEWER_PASSWORD_HASH=
# Sign in tries in a row before a short wait (raised only for the browser tests)
LOGIN_BURST=5

# Who the offers and the job posts speak for. A live start is refused while this is the placeholder.
COMPANY_NAME=Example Company

# Hiring rules (decided defaults; the implementer can change any of them for the client)
# Days after a decision that the personal data of a declined or withdrawn applicant is deleted
RETENTION_DAYS=365
# Days after which the personal data of an applicant nobody decided on is deleted (0 means never)
OPEN_RETENTION_DAYS=730
# The smallest group a fairness report compares. A smaller group is shown as "fewer than N" with no counts. Never below 2.
FAIRNESS_MIN_GROUP=10
FAIRNESS_THRESHOLD=4/5
MIN_SCORECARDS=2
BLIND_DEFAULT=true
REDACT_INSTITUTIONS=true
# Extra words a rubric may not look for, comma separated (for example words that stand in for age, school or language). A built in list is always checked too.
PROXY_TERMS=
# Clubs, societies or other words that are hidden from the scorer and the reviewer as personal details, comma separated, on top of the built in list (best effort: see docs/14).
REDACT_EXTRA_TERMS=

# Files
EXPORT_DIR=./exports
UPLOAD_MAX_BYTES=5000000
# A PDF resume up to this size is kept as it arrived, so a person can open it (0 keeps none). It is erased with the person.
KEEP_ORIGINAL_MAX_BYTES=2000000

# Signed application webhook (an ATS or a form tool posts one applicant)
APPLICATION_WEBHOOK_SECRET=
# Let a resume link or an ATS address reach this computer or a private network. Leave false everywhere except a test machine.
ALLOW_HTTP_LOCAL_TARGETS=false

# Where applicants come from: seed (the demo), ashby, workable or greenhouse for the ATS; seed or imap for the mailbox
ATS_ADAPTER=seed
MAILBOX_ADAPTER=seed

# Ashby, fill in together (read only)
ASHBY_API_KEY=
ASHBY_BASE_URL=https://api.ashbyhq.com

# Workable, fill in together (read only)
WORKABLE_TOKEN=
WORKABLE_SUBDOMAIN=
WORKABLE_BASE_URL=

# Greenhouse, fill in together (read only)
GREENHOUSE_TOKEN=
GREENHOUSE_BASE_URL=https://harvest.greenhouse.io

# Mailbox over IMAP (reads application emails and marks one read only after it is stored; never sends)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true
# A message over this size is never downloaded (it is listed under Not added and marked read), and one run holds at most the second number of message bytes
IMAP_MAX_MESSAGE_BYTES=10000000
IMAP_MAX_RUN_BYTES=60000000

# Interview invites: seed (a file), calcom or google
CALENDAR_ADAPTER=seed

# Cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_BASE_URL=https://api.cal.com/v2

# Google Calendar
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_BASE_URL=https://www.googleapis.com/calendar/v3

# Offer hand off to your signing tool: package (a file for a person) or seed
HANDOFF_ADAPTER=package

# Model for scoring and drafting: offline (default, rules, no account), fixture (recorded answers) or anthropic (needs a key, UNVERIFIED against the real service)
LLM_BACKEND=offline
# The older switch: live means anthropic when LLM_BACKEND is empty. Leave it.
LLM_MODE=fixture
# rules (default) | model: SCORER=model scores one criterion at a time with the model, only when LLM_BACKEND is fixture or anthropic. A person still decides everything.
SCORER=rules

# Model settings, used only when LLM_BACKEND is anthropic or fixture
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2026-10-21
LLM_HARD_MODEL=claude-sonnet-5-5
LLM_BULK_MODEL=claude-haiku-5-5
# One model id for both kinds. Empty uses the two above.
LLM_MODEL=
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2
# Spend limits for the live model: the most calls per process and the most tracked spend in US dollars. Empty means no limit.
LLM_CALL_BUDGET=
LLM_BUDGET_USD=
LLM_THINKING=default
LLM_FIXTURES_DIR=
LLM_RECORD=false
LLM_REDACT=true
LLM_LOG_PROMPTS=false

# Web app (set on the web host)
API_BASE_URL=http://127.0.0.1:8000
# 1 only for plain http on localhost. Never in production.
INSECURE_COOKIES=
