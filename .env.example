# Slatehire environment. Names only. Copy to .env and fill in what you use. Never commit .env.
# A group of settings you leave empty is treated as switched off.

# Core
APP_NAME=slatehire
DATABASE_URL=sqlite:///./slatehire.sqlite3
SESSION_SECRET=change-me-to-a-long-random-string
MODE=draft
DEMO_MODE=true
KILL_SWITCH=false
# offline (default, rules, no account) | fixture (recorded answers) | anthropic (a real model; needs ANTHROPIC_API_KEY; UNVERIFIED live)
LLM_BACKEND=offline
# rules (default) | model: SCORER=model scores one criterion at a time with the model, only when LLM_BACKEND is fixture or anthropic. UNVERIFIED live. A person still decides everything.
SCORER=rules
SEED_DIR=

# Owner login (DEMO_MODE off needs a real password hash, see tools/hash_password.py)
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=
APPROVER_EMAIL=
APPROVER_PASSWORD_HASH=
MEMBERS_JSON=
# Optional read only sign in (looks at everything, changes nothing)
VIEWER_EMAIL=
VIEWER_PASSWORD_HASH=
# Sign in tries in a row before a short wait (raised only for the browser tests)
LOGIN_BURST=5

# Hiring rules (decided defaults; the implementer can change any of them for the client)
RETENTION_DAYS=365
FAIRNESS_MIN_GROUP=10
FAIRNESS_THRESHOLD=4/5
MIN_SCORECARDS=2
BLIND_DEFAULT=true
REDACT_INSTITUTIONS=true

# Files
EXPORT_DIR=./exports
UPLOAD_MAX_BYTES=5000000

# Signed application webhook (an ATS or a form tool posts one applicant)
APPLICATION_WEBHOOK_SECRET=
ALLOW_HTTP_LOCAL_TARGETS=false

# Where applicants come from
ATS_ADAPTER=seed
MAILBOX_ADAPTER=seed

# Ashby (read only)
ASHBY_API_KEY=
ASHBY_BASE_URL=https://api.ashbyhq.com

# Workable (read only)
WORKABLE_TOKEN=
WORKABLE_SUBDOMAIN=

# Greenhouse (read only)
GREENHOUSE_TOKEN=
GREENHOUSE_BASE_URL=https://harvest.greenhouse.io

# Mailbox over IMAP (reads application emails, never sends)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true

# Interview invites
CALENDAR_ADAPTER=seed

# Cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_BASE_URL=https://api.cal.com/v2

# Google Calendar
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Offer hand off to your signing tool
HANDOFF_ADAPTER=package

# Live model (not needed for the demo, never run by the author)
ANTHROPIC_API_KEY=
LLM_HARD_MODEL=claude-sonnet-5-5
LLM_BULK_MODEL=claude-haiku-5-5

# Web app (set on the web host)
API_BASE_URL=http://127.0.0.1:8000
INSECURE_COOKIES=
POSTGRES_PASSWORD=
